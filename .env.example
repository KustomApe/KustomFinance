DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgres://localhost:5432/kustomfinance
# 社内LANからアクセスする場合はサーバーPCのIP/ホスト名を追加
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Tokyo

# レシートのOCR: tesseract（ローカルで完結・既定） / claude（高精度。画像が Anthropic に送信されます）
OCR_ENGINE=tesseract
# OCR_ENGINE=claude のときは API キーを設定
# ANTHROPIC_API_KEY=
